# large artifacts — Drive links go in README instead
*/checkpoints/*.pt
*/data/raw/*
*/data/manual/pdfs/*
*/data/processed/*.txt
!*/checkpoints/.gitkeep

# Small state/summary files under data/raw/ are worth keeping despite the
# blanket rule above (collection resume cursors, per-run summaries) — not
# large data, just bookkeeping. Every ancestor directory on the path must
# be re-included too (git never descends into an excluded directory to
# check per-file negations), so this walks the whole path back down —
# then re-excludes the actual large data files that live alongside them
# (re-opening a directory makes everything in it visible again, not just
# the two files being un-ignored).
!*/data/raw/manual/
!*/data/raw/manual/news/
*/data/raw/manual/news/*.jsonl
!*/data/raw/manual/news/collection_state.json
!*/data/raw/manual/news/news_collection_summary.json

# Hindi/Nepali IndicCorp pipeline outputs
*/data/intermediate/*
*/data/final/*.txt
*/data/tokenized/*.bin
*/reports/tables/*
!*/data/intermediate/.gitkeep
!*/data/final/.gitkeep
!*/data/tokenized/.gitkeep
!*/reports/tables/.gitkeep

# Tokenizer artifacts ARE required Phase 1 deliverables (spec 1.3, items 6 & 7:
# "Vocabulary files (one per language)", "Tokenizer model files (one per
# language)"). They are small (~8MB total for every trained vocab size across
# both languages), so they are committed directly rather than linked from Drive.
# Figures under */reports/figures/ are likewise graded artifacts and tracked.


nepali/data/intermediate/*
nepali/data/final/*.txt
nepali/data/raw/*

hindi/data/intermediate/*
hindi/data/final/*.txt
hindi/data/raw/*


# NOTE: */data/run_stats/ and */metadata/ are deliberately NOT ignored —
# small per-pipeline-stage-run JSON summaries and final analysis reports
# (see shared/run_stats.py), not large data, tracked normally.

# Deduplication database
*.db

__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.DS_Store
venv/
.env
.venv/

# --- Phase 2 ---
# Checkpoints are large (~300MB each) -> Google Drive, links in README.
*/checkpoints/**/*.pt
bonus_ablation/*/checkpoints/**/*.pt
!*/checkpoints/**/.gitkeep

# --- Phase 3 ---
# Finetuned checkpoints, same rule as pretrained ones above -> Drive.
*/checkpoints_ft/**/*.pt
!*/checkpoints_ft/**/.gitkeep

# Training logs, loss-curve CSVs, metric JSON and figures are GRADED
# artifacts and must live in the branch — the spec is explicit that
# graders will not open Drive or external dashboards to find them.
# Nothing under */logs/, */eval/results/ or report/figures/ is ignored.

# Evaluation results from untrained/placeholder runs are not results.
# Real ones are committed explicitly once a trained checkpoint exists.
*/eval/results/attention_analysis.json

# Packaging output for Kaggle — rebuilt by ./package_for_kaggle.sh
dist/

# Personal scratch
MY_KAGGLE_LINKS.md

# Course PDFs (copyrighted course materials) — reference-only, never committed
course_pdfs/

# LaTeX build junk for report/latex/final_report.tex — only the .tex source
# and the compiled final_report.pdf are graded artifacts.
report/latex/*.aux
report/latex/*.log
report/latex/*.out
report/latex/*.toc
report/latex/*.fls
report/latex/*.fdb_latexmk
report/latex/*.synctex.gz
